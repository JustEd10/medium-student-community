{
  "info": {
    "name": "Медиум SQLite Локальная проверка",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Только отдельная локальная база. Коллекция создаёт и удаляет свои учебные записи. После шага 06 остановите Runner и перезапустите локальный сервер перед шагом 07. Не направляйте на рабочий сайт."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "lessonToken",
      "value": ""
    },
    {
      "key": "itemId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Вход в учебное API",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"user\",\n  \"password\": \"qwerty\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"lessonToken\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Создать вопрос",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{lessonToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/items",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Кто объяснит матрицы?\",\n  \"body\": \"Локальный вопрос для проверки SQLite\",\n  \"category\": \"Учёба\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"itemId\", String(pm.response.json().id));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Получить вопрос",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/items/{{itemId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Тот же вопрос\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"itemId\"))));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Изменить вопрос",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{lessonToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/items/{{itemId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Кто поможет разобрать матрицы?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "05 Добавить ответ",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{lessonToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/records",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"item_id\": \"{{itemId}}\",\n  \"body\": \"Разберём умножение матриц на примере\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 JOIN ответ вместе с названием вопроса",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/records?item_id={{itemId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"JOIN возвращает название\", () => pm.expect(pm.response.json()[0].item_title).to.eql(\"Кто поможет разобрать матрицы?\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Повторить после перезапуска сервера",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/items/{{itemId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Сохранён вопрос и ответ\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json().answers.length).to.be.above(0); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Удалить свой тестовый вопрос",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{lessonToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/items/{{itemId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Убедиться в удалении",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/items/{{itemId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
